# Optional Google Gemini API key. Add to .env.local on your own computer.
# Never commit a real key. Without it the copywriter returns a labeled template.
GEMINI_API_KEY=

# Background remover is a second local Python process, NOT a hosted API.
NEXT_PUBLIC_BG_API_URL=http://127.0.0.1:8000

# Explicit non-default rembg model selection.
BG_MODEL=u2net
