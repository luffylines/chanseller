# Optional: never commit a real key.
# If unset, Copywriter uses a clearly labeled LOCAL TEMPLATE (not AI).
GEMINI_API_KEY=

# Local Python worker only. No hosted image service.
NEXT_PUBLIC_BG_API_URL=http://127.0.0.1:8000

# Worker supports a separate localhost origin.
# U2Net is chosen explicitly; do not use the newer rembg default model.
BG_MODEL=u2net
